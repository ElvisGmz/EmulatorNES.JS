{
  "name": "emulator-nes-js",
  "private": true,
  "version": "2.0.0",
  "description": "NES emulator for desktop and mobile built on top of jsnes",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jsnes": "^2.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19"
  }
}
